# The API base URL, including the /v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:3000/v1

# Cloudflare Turnstile site key for the login page.
#
# Public by design — it names the widget, and the secret that actually verifies
# a solution is TURNSTILE_SECRET_KEY on the API, never here. Anything prefixed
# NEXT_PUBLIC_ is compiled into the JavaScript bundle and readable by anyone.
#
# Leave empty in local development: the widget is not rendered and the API skips
# verification outside production. In production the API refuses every sign-in
# when its secret is missing, so a half-configured deploy fails closed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The basemap for the live map, in one of two forms.
#
#   pmtiles://https://<host>/punjab-YYYYMMDD.pmtiles
#       One self-hosted vector archive, read by HTTP range requests. No
#       per-tile billing. Build it with scripts/extract-basemap.sh; the bucket
#       must allow the panel's origin with `Range` in AllowedHeaders, or the
#       map renders nothing at all.
#
#   https://<host>/{z}/{x}/{y}.png
#       A conventional raster tile endpoint, billed per tile.
#
# Unset falls back to OpenStreetMap's public server, which is correct for
# development and NOT permitted for commercial dispatch traffic.
NEXT_PUBLIC_MAP_TILES_URL=

# Only for the raster form: a second, darker tile endpoint for night mode.
# A PMTiles archive needs no second file — the same archive renders either
# flavour — so leave this unset when using one.
NEXT_PUBLIC_MAP_TILES_URL_DARK=

# Where document renditions are served from, as a bare origin.
#
# The verification screen displays identity documents from the object store on
# a signed URL, and the panel's Content-Security-Policy has to name that origin
# or the browser refuses to paint it — a broken image, with the bucket, the
# signature and the API all perfectly healthy. `check:storage` cannot see this:
# it runs on the server, and the server is not the one being refused.
#
# AWS:   https://<bucket>.s3.<region>.amazonaws.com
# R2:    https://<account>.r2.cloudflarestorage.com
# MinIO: whatever S3_ENDPOINT is on the API, e.g. http://localhost:9000
NEXT_PUBLIC_DOCUMENT_ORIGIN=
