# The API base URL, including the /v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:3000/v1

# Cloudflare Turnstile site key for the login page.
#
# Public by design — it names the widget, and the secret that actually verifies
# a solution is TURNSTILE_SECRET_KEY on the API, never here. Anything prefixed
# NEXT_PUBLIC_ is compiled into the JavaScript bundle and readable by anyone.
#
# Leave empty in local development: the widget is not rendered and the API skips
# verification outside production. In production the API refuses every sign-in
# when its secret is missing, so a half-configured deploy fails closed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
